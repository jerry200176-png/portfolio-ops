{
  "budgets": {
    "max_files_changed": 12,
    "max_loc_changed": 400
  },
  "checks_allowlist": [
    "npm test",
    "npm run lint",
    "pytest",
    "python -m pytest",
    "python3 -m pytest"
  ],
  "coherence_rules": [],
  "composed_at": "2026-08-28T19:57:18+08:00",
  "deny_patterns": [
    "**/.env*",
    ".git/**",
    "~/.aws/**",
    "~/.ssh/**"
  ],
  "governance": {
    "kernel": {
      "name": "exo-kernel",
      "version": "0.1.0"
    },
    "rules": [
      {
        "actions": [
          "read",
          "write"
        ],
        "id": "RULE-SEC-001",
        "message": "Blocked by RULE-SEC-001 (Secrets). Use secret injection.",
        "patterns": [
          "~/.aws/**",
          "~/.ssh/**",
          "**/.env*"
        ],
        "type": "filesystem_deny"
      },
      {
        "actions": [
          "read",
          "write",
          "delete"
        ],
        "id": "RULE-GIT-001",
        "message": "Blocked by RULE-GIT-001 (.git internals are protected).",
        "patterns": [
          ".git/**"
        ],
        "type": "filesystem_deny"
      },
      {
        "id": "RULE-LOCK-001",
        "message": "Blocked by RULE-LOCK-001 (acquire a ticket lock first).",
        "type": "require_lock"
      },
      {
        "id": "RULE-CHECK-001",
        "message": "Blocked by RULE-CHECK-001 (checks must pass before done).",
        "type": "require_checks"
      },
      {
        "governance_requires": [
          "approval:human"
        ],
        "id": "RULE-EVO-001",
        "message": "Practice is mutable, governance requires explicit human approval.",
        "practice_requires": [
          "approval:any(human|trusted_agent)"
        ],
        "type": "evolution_gate"
      },
      {
        "id": "RULE-EVO-002",
        "message": "Patch-first evolution required.",
        "requires": [
          "proposal_artifact",
          "patch_artifact",
          "review_artifact",
          "audit_trail"
        ],
        "type": "patch_first"
      }
    ]
  },
