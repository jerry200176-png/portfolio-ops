#!/usr/bin/env python3
"""Resolve portable planning/implementation tiers for Codex or Cursor.

Does not launch agents, mutate permissions, or silently downgrade protected
Sol/Astra commitments. Prints JSON for evidence capture.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tomllib
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MAP = ROOT / "config" / "provider-model-map.toml"


def _load_map(path: Path) -> dict:
    with path.open("rb") as handle:
        return tomllib.load(handle)


def _available_from_arg(value: str | None) -> set[str] | None:
    if value is None:
        return None
    if value == "-":
        text = sys.stdin.read()
    else:
        text = Path(value).read_text(encoding="utf-8")
    models: set[str] = set()
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        # `agent models` lines look like: "slug - Label"
        slug = line.split(" ", 1)[0].strip()
        if slug:
            models.add(slug)
    return models


def _codex_dry_run(args: argparse.Namespace) -> dict:
    route = Path(os.environ.get("CODEX_ROUTE_BIN", str(Path(__file__).with_name("codex-route"))))
    cmd = [
        str(route),
        "--complexity", args.complexity,
        "--ambiguity", args.ambiguity,
        "--blast-radius", args.blast_radius,
        "--risk", args.risk,
        "--workload", args.workload,
        "--dry-run",
        "--",
        "noop",
    ]
    if args.protected_reasoning:
        cmd.insert(-2, "--protected-reasoning")
    if args.sol_insufficient:
        cmd.insert(-2, "--sol-insufficient")
    if args.astra_eligible:
        cmd.insert(-2, "--astra-eligible")
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        return {
            "provider": "codex",
            "ok": False,
            "fail_closed": True,
            "error": (proc.stderr or proc.stdout or "codex-route failed").strip(),
            "command": cmd,
        }
    payload = json.loads(proc.stdout)
    payload["provider"] = "codex"
    payload["ok"] = True
    payload["fail_closed"] = False
    return payload


def _cursor_resolve(args: argparse.Namespace, mapping: dict) -> dict:
    tiers = mapping.get("cursor", {}).get("tiers", {})
    tier = args.tier
    if args.role == "planning":
        tier = "astra" if args.astra_eligible and args.sol_insufficient else "sol"
    elif args.role == "implementation":
        tier = "luna"
    elif args.role == "default":
        tier = "terra"
    requested = tier
    model = tiers.get(tier, "")
    available = _available_from_arg(args.available_models)
    result = {
        "provider": "cursor",
        "requested_tier": requested,
        "selected_tier": None,
        "model": None,
        "ok": False,
        "fail_closed": False,
        "resolution": None,
        "role": args.role,
        "signals": {
            "complexity": args.complexity,
            "risk": args.risk,
            "workload": args.workload,
            "protected_reasoning": args.protected_reasoning,
            "sol_insufficient": args.sol_insufficient,
            "astra_eligible": args.astra_eligible,
        },
    }
    if not isinstance(model, str) or not model.strip():
        result["fail_closed"] = True
        result["error"] = f"cursor tier {requested!r} has no mapped model id (unavailable)"
        result["resolution"] = "unavailable_mapping"
        return result
    if available is not None and model not in available:
        # Never silently substitute composer/session_light for sol/astra/luna.
        result["fail_closed"] = True
        result["error"] = (
            f"requested cursor model {model!r} for tier {requested!r} not in available set; "
            "CAPACITY_BLOCKED (no silent downgrade)"
        )
        result["resolution"] = "capacity_blocked"
        result["model"] = model
        return result
    if args.protected_decision:
        result["ok"] = True
        result["selected_tier"] = requested
        result["model"] = model
        result["resolution"] = "selected_plan_only"
        result["implementation_allowed"] = False
        result["protected_decision"] = True
        result["note"] = "Plan may be produced; implementation/activation/data repair remain Founder-gated"
        return result
    result["ok"] = True
    result["fail_closed"] = False
    result["selected_tier"] = requested
    result["model"] = model
    result["resolution"] = "selected"
    result["implementation_allowed"] = args.role != "planning"
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", choices=("codex", "cursor"), required=True)
    parser.add_argument("--map", type=Path, default=DEFAULT_MAP)
    parser.add_argument("--role", choices=("planning", "implementation", "default", "tier"), default="tier")
    parser.add_argument("--tier", default="sol", help="used when --role=tier")
    parser.add_argument("--complexity", default="medium")
    parser.add_argument("--ambiguity", default="medium")
    parser.add_argument("--blast-radius", default="medium", dest="blast_radius")
    parser.add_argument("--risk", default="medium")
    parser.add_argument("--workload", default="coding")
    parser.add_argument("--protected-reasoning", action="store_true")
    parser.add_argument("--protected-decision", action="store_true",
                        help="plan OK but implementation not authorized")
    parser.add_argument("--sol-insufficient", action="store_true")
    parser.add_argument("--astra-eligible", action="store_true")
    parser.add_argument(
        "--available-models",
        help="path to `agent models` output, or '-' for stdin; omit to skip live availability check",
    )
    args = parser.parse_args()
    mapping = _load_map(args.map)
    if args.provider == "codex":
        payload = _codex_dry_run(args)
        if args.protected_decision and payload.get("ok"):
            payload["implementation_allowed"] = False
            payload["protected_decision"] = True
            payload["note"] = "Plan may be produced; implementation/activation/data repair remain Founder-gated"
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0 if payload.get("ok") else 2
    payload = _cursor_resolve(args, mapping)
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0 if payload.get("ok") else 2


if __name__ == "__main__":
    raise SystemExit(main())
