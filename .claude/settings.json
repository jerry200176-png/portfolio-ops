{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/workspace/portfolio-ops/.claude/hooks/guard_bash.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__(merge_pull_request|merge_pr)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/workspace/portfolio-ops/.claude/hooks/deny_tool.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Gmail__(create_draft|update_draft|label_message|label_thread|unlabel_message|unlabel_thread|apply_sensitive_message_label|apply_sensitive_thread_label|create_label|update_label|delete_label|send_message|send_draft|trash_message|untrash_message|delete_message|delete_thread|archive_message|batch_delete_messages|batch_modify_messages)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/workspace/portfolio-ops/.claude/hooks/deny_tool.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
