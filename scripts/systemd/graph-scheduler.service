[Unit]
Description=Graph Control Plane autonomous scheduler (portfolio-ops)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Stable runtime checkout maintained by scripts/install-graph-scheduler-user-unit.sh
WorkingDirectory=%h/workspace/state/portfolio-ops/scheduler-runtime
Environment=GRAPH_CONTROL_DB=%h/workspace/state/portfolio-ops/graph-control.sqlite
Environment=GRAPH_REAL_CODEX=1
Environment=PYTHONPATH=%h/workspace/state/portfolio-ops/scheduler-runtime
ExecStart=/usr/bin/python3 -m agent_graph.cli schedule-run --real-codex --project portfolio-ops
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
