[Unit]
Description=Graph Control Plane autonomous scheduler (portfolio-ops)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/tasks/portfolio-ops/graph-v1-autonomous-20260915
Environment=GRAPH_CONTROL_DB=%h/workspace/state/portfolio-ops/graph-control.sqlite
Environment=GRAPH_REAL_CODEX=1
ExecStart=%h/workspace/tasks/portfolio-ops/graph-v1-autonomous-20260915/scripts/graph schedule-run --real-codex
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
